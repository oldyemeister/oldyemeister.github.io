/*
 *   显示从小内存中读取的图案，在VGA输出的(x,y)位置显示。
 *   要设置坐标，首先将所需的y值置于SW[6:0]上，然后按下KEY[1]。
 *   接下来，将所需的x值置于SW[7:0]上，然后按下KEY[2]。
 *   (x,y)坐标以十六进制显示在(HEX3-2, HEX1-0)上。
 *   最后，按下KEY[3]在位置(x,y)绘制图案。
 */
module drawmario(
    input CLOCK_50,	
    input [7:0] SW,
    input [3:0] KEY,
    output [6:0] HEX3, HEX2, HEX1, HEX0,
    output [7:0] VGA_R,
    output [7:0] VGA_G,
    output [7:0] VGA_B,
    output VGA_HS,
    output VGA_VS,
    output VGA_BLANK_N,
    output VGA_SYNC_N,
    output VGA_CLK
);

    wire [7:0] X;           // 对象的起始x位置
    wire [6:0] Y;           // 对象的起始y位置
    wire [3:0] XC, YC;      // 用于访问对象内存
    wire Ex, Ey;
    wire [7:0] VGA_X;       // 对象像素的x位置
    wire [6:0] VGA_Y;       // 对象像素的y位置
    wire [2:0] VGA_COLOR;   // 对象像素的颜色

    // 存储(x,y)起始位置
    regn #(7) U1 (.R(SW[6:0]), .Resetn(KEY[0]), .E(~KEY[1]), .Clock(CLOCK_50), .Q(Y));
    regn #(8) U2 (.R(SW[7:0]), .Resetn(KEY[0]), .E(~KEY[2]), .Clock(CLOCK_50), .Q(X));

    // 列计数器
    count #(4) U3 (.Clock(CLOCK_50), .Resetn(KEY[0]), .E(Ex), .Q(XC));
    // 当VGA开始绘制时使能XC
    regn #(1) U5 (.R(1'b1), .Resetn(KEY[0]), .E(~KEY[3]), .Clock(CLOCK_50), .Q(Ex));
    // 行计数器
    count #(4) U4 (.Clock(CLOCK_50), .Resetn(KEY[0]), .E(Ey), .Q(YC));
    // 在每行结束时使能YC
    assign Ey = (XC == 4'b111111);

    hex7seg H3 (.hex(X[7:4]), .display(HEX3));
    hex7seg H2 (.hex(X[3:0]), .display(HEX2));
    hex7seg H1 (.hex({1'b0, Y[6:4]}), .display(HEX1));
    hex7seg H0 (.hex(Y[3:0]), .display(HEX0));

    // 从对象内存读取像素颜色
    object_mem U6 (.address({YC, XC}), .clock(CLOCK_50), .q(VGA_COLOR));
    // 存储当前的(x,y)地址以保持同步
    regn #(8) U7 (.R(X + XC), .Resetn(KEY[0]), .E(1'b1), .Clock(CLOCK_50), .Q(VGA_X));
    regn #(7) U8 (.R(Y + YC), .Resetn(KEY[0]), .E(1'b1), .Clock(CLOCK_50), .Q(VGA_Y));

    assign plot = ~KEY[3];

    // 连接到VGA控制器
    vga_adapter VGA (
        .resetn(KEY[0]),
        .clock(CLOCK_50),
        .colour(VGA_COLOR),
        .x(VGA_X),
        .y(VGA_Y),
        .plot(~KEY[3]),
        .VGA_R(VGA_R),
        .VGA_G(VGA_G),
        .VGA_B(VGA_B),
        .VGA_HS(VGA_HS),
        .VGA_VS(VGA_VS),
        .VGA_BLANK_N(VGA_BLANK_N),
        .VGA_SYNC_N(VGA_SYNC_N),
        .VGA_CLK(VGA_CLK)
    );
    defparam VGA.RESOLUTION = "160x120";
    defparam VGA.MONOCHROME = "FALSE";
    defparam VGA.BITS_PER_COLOUR_CHANNEL = 1;
    defparam VGA.BACKGROUND_IMAGE = "map.mif";

endmodule
// 其余模块保持不变

module regn #(parameter n = 8) (
    input [n-1:0] R,
    input Resetn,
    input E,
    input Clock,
    output reg [n-1:0] Q
);

    always @(posedge Clock)
        if (!Resetn)
            Q <= 0;
        else if (E)
            Q <= R;

endmodule

module count #(parameter n = 8) (
    input Clock,
    input Resetn,
    input E,
    output reg [n-1:0] Q
);

    always @(posedge Clock)
        if (!Resetn)
            Q <= 0;
        else if (E)
            Q <= Q + 1;

endmodule

module hex7seg (
    input [3:0] hex,
    output reg [6:0] display
);

    /*
     *       0  
     *      ---  
     *     |   |
     *    5|   |1
     *     | 6 |
     *      ---  
     *     |   |
     *    4|   |2
     *     |   |
     *      ---  
     *       3  
     */
    always @ (hex)
        case (hex)
            4'h0: display = 7'b1000000;
            4'h1: display = 7'b1111001;
            4'h2: display = 7'b0100100;
            4'h3: display = 7'b0110000;
            4'h4: display = 7'b0011001;
            4'h5: display = 7'b0010010;
            4'h6: display = 7'b0000010;
            4'h7: display = 7'b1111000;
            4'h8: display = 7'b0000000;
            4'h9: display = 7'b0011000;
            4'hA: display = 7'b0001000;
            4'hB: display = 7'b0000011;
            4'hC: display = 7'b1000110;
            4'hD: display = 7'b0100001;
            4'hE: display = 7'b0000110;
            4'hF: display = 7'b0001110;
        endcase

endmodule
